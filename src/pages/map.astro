---
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title="访客地图" description="访客省份分布">
    <div class="card-base w-full px-6 py-6 mb-4 rounded-[var(--radius-large)]">
        <h1 class="text-2xl font-bold mb-2 text-black/90 dark:text-white/90">访客地图</h1>
        <p class="text-sm text-black/50 dark:text-white/50 mb-4">访客所在省份分布（仅匿名统计省份，不记录具体位置）</p>
        <div id="visitor-map" style="width:100%;height:560px;"></div>
    </div>
</MainGridLayout>

<script>
import * as echarts from "echarts";

(function () {
    const container = document.getElementById("visitor-map");
    if (!container) return;

    function render(geoJson, data) {
        const values = Object.values(data).filter((v) => typeof v === "number");
        const maxVal = values.length ? Math.max(...values) : 1;
        const chart = echarts.init(container);
        echarts.registerMap("china", geoJson);
        chart.setOption({
            tooltip: {
                trigger: "item",
                formatter: (p) => `${p.name}：${p.value || 0} 位访客`,
            },
            visualMap: {
                min: 0,
                max: maxVal,
                left: 16,
                bottom: 16,
                text: ["多", "少"],
                calculable: true,
                inRange: { color: ["#dbeafe", "#6366f1"] },
                textStyle: { color: "#888" },
            },
            series: [
                {
                    name: "访客",
                    type: "map",
                    map: "china",
                    roam: true,
                    label: { show: false },
                    itemStyle: { borderColor: "#fff", areaColor: "#dbeafe" },
                    emphasis: {
                        label: { show: true, fontSize: 12 },
                        itemStyle: { areaColor: "#818cf8" },
                    },
                    data: Object.entries(data).map(([name, value]) => ({ name, value })),
                },
            ],
        });
    }

    Promise.all([
        fetch("/geo/china.json").then((r) => r.json()),
        fetch("/api/visitors").then((r) => r.json()),
    ])
        .then(([geo, data]) => render(geo, data))
        .catch(() => {
            container.innerHTML = '<p style="text-align:center;color:#888;padding:48px;">数据加载失败，请稍后刷新</p>';
        });
})();
</script>
